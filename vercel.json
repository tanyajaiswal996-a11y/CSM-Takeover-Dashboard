{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node build-static.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "csm-takeover-dashboard.html",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?p=$1" }
  ]
}
